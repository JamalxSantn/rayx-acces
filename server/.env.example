# Copy to .env to override defaults
PORT=3001
JWT_SECRET=change-me-to-a-long-random-string
# Name shown in the Google Authenticator app
TOTP_ISSUER=Rayx Acces
# Shared secret the Discord bot uses to reach this API.
# Must match bot/config.json -> api.key
BOT_API_KEY=change-me-to-match-the-bot
# Hidden owner login phrase (typed as the password on the normal login form).
# Replace with your own before going live.
SECRET_PHRASE=change-me-too
